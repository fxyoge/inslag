<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:ist="urn:inslag-state-tree" datamodel="luau" name="activity">
  <datamodel><data id="target" expr="'north'"/></datamodel>
  <state id="active">
    <ist:activity id="path" name="find_path">
      <ist:arg name="destination" expr="target"/>
    </ist:activity>
    <transition event="done.activity.path"/>
    <transition event="error.activity.path"/>
  </state>
</scxml>

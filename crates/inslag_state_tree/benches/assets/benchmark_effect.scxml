<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:ist="urn:inslag-state-tree" datamodel="luau">
  <datamodel><data id="amount" expr="1"/></datamodel>
  <state id="left">
    <transition event="tick" target="right">
      <ist:effect name="benchmark">
        <ist:arg name="amount" expr="amount"/>
      </ist:effect>
    </transition>
  </state>
  <state id="right">
    <transition event="tick" target="left">
      <ist:effect name="benchmark">
        <ist:arg name="amount" expr="amount"/>
      </ist:effect>
    </transition>
  </state>
</scxml>

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "separateMajorMinor": false,
  "pinDigests": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "automerge": true,
  "platformAutomerge": false,
  "packageRules": [{
    "description": "Keep MSRV pinned",
    "matchManagers": ["mise"],
    "matchPackageNames": ["rust"],
    "matchFileNames": ["mise.msrv.toml"],
    "enabled": false
  }, {
    "matchPackageNames": ["/bevy_.+$/"],
    "groupName": "Bevy"
  }]
}
